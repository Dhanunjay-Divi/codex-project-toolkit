#!/usr/bin/env python3
"""Launch the pinned, project-scoped Ruflo MCP under macOS sandbox-exec."""

import os
from pathlib import Path
import pwd
import shutil


def main():
    integration = Path(__file__).resolve().parent
    state = integration / "state"
    state.mkdir(mode=0o700, parents=True, exist_ok=True)
    state.chmod(0o700)
    node = shutil.which("node")
    sandbox = Path("/usr/bin/sandbox-exec")
    if not node or not sandbox.is_file():
        raise SystemExit("Ruflo requires Node.js and macOS sandbox-exec")
    user = pwd.getpwuid(os.getuid()).pw_name
    env = {
        "PATH": ":".join((str(Path(node).parent), "/usr/bin", "/bin", "/usr/sbin", "/sbin")),
        "LANG": "en_US.UTF-8",
        "USER": user,
        "LOGNAME": user,
    }
    argv = [
        str(sandbox), "-D", "STATE_ROOT=" + str(state),
        "-f", str(integration / "sandbox.sb"), node,
        str(integration / "ruflo-memory-mcp.mjs"),
    ]
    os.execve(sandbox, argv, env)


if __name__ == "__main__":
    main()
